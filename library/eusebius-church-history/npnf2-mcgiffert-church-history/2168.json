{"workId":"eusebius-church-history","editionId":"npnf2-mcgiffert-church-history","language":"english","ref":"p6.p24","title":"p6.p24","segments":[{"ref":"p6.p24.1","text":"mentioned by Eusebius."},{"ref":"p6.p24.2","text":"Bishops of Rome."},{"ref":"p6.p24.3","text":"(Dates taken from the table given by Lipsius in his Chronologie der röm. Bischöfe, p. 263 sq.)"},{"ref":"p6.p24.4","text":"Linus."},{"ref":"p6.p24.5","text":"Pontianus, 5 years 2 months 7 days; (July 21?), 230–Sept. 28, 235."},{"ref":"p6.p24.6","text":"Anencletus."},{"ref":"p6.p24.7","text":"Anteros, 1 month 12 days; Nov. 21, 235–Jan. 3, 236."},{"ref":"p6.p24.8","text":"Clement."},{"ref":"p6.p24.9","text":"Fabianus, 14 years 10 days; 236–Jan. 20, 250. Vacancy from Jan. 21, 250–March, 251."},{"ref":"p6.p24.10","text":"Evarestus."},{"ref":"p6.p24.11","text":"Cornelius, 2 years 3 months 10 days; beginning of March, 251–middle of June, 253."},{"ref":"p6.p24.12","text":"Alexander."},{"ref":"p6.p24.13","text":"Lucius, 8 months 10 days; June (25?), 253–March 5, 254."},{"ref":"p6.p24.14","text":"Xystus I, for about ten years; died between 124 and 126."},{"ref":"p6.p24.15","text":"Stephanus, 3 years 2 months 21 days; (May 12?), 254–Aug. 6, 258."},{"ref":"p6.p24.16","text":"Telesphorus, 11 years; died between 135 and 137."},{"ref":"p6.p24.17","text":"Xystus II., 11 months 12 (6?) days; Aug. 24 (31?), 257–Aug. 6, 258."},{"ref":"p6.p24.18","text":"Hyginus, 4 years; died between 139 and 141."},{"ref":"p6.p24.19","text":"Dionysius, 9 years 5 months 2 days; July 22, 259–Dec. 27, 268."},{"ref":"p6.p24.20","text":"Pius, 15–16 years; died between 154 and 156."},{"ref":"p6.p24.21","text":"Felix I., 5 years 11 months 25 days; Jan. 5, 269–Dec. 30, 274."},{"ref":"p6.p24.22","text":"Anicetus, 11–12 years; died in 166 or 167."},{"ref":"p6.p24.23","text":"Eutychian, 8 years 11 months 3 days; (Jan. 5?) 275–Dec. 8, 283."},{"ref":"p6.p24.24","text":"Soter, 8–9 years; died in 174 or 175."},{"ref":"p6.p24.25","text":"Caius, 12 years 4 months 6 days; Dec. 17, 283–April 22, 296."},{"ref":"p6.p24.26","text":"Eleutherus, 15 years; died in 189."},{"ref":"p6.p24.27","text":"Marcellinus, 8 years 3 months 25 days; June 30, 296–(Oct. 25?), 304. Vacancy until 307."},{"ref":"p6.p24.28","text":"Victor, 9–10 years; 189–198 or 199."},{"ref":"p6.p24.29","text":"Marcellus, 1 year 7 months 21 days; (May 24?), 307–Jan. 15, 309."},{"ref":"p6.p24.30","text":"Zephyrinus, 18–19 years; 198 or 199–217 (Aug. 26?)."},{"ref":"p6.p24.31","text":"Eusebius, 3 (4?) months 23 (16?) days; April 23 (16?), 309–Aug. 17, 309. Vacancy until 310."},{"ref":"p6.p24.32","text":"Callistus, 5 years; 217–Oct. 14, 222."},{"ref":"p6.p24.33","text":"Miltiades, 3 years 6 months 8 days; July 2, 310–Jan. 10 (11?), 314."},{"ref":"p6.p24.34","text":"Urbanus, 8 years; 222–230 (May 19?)."}]}
