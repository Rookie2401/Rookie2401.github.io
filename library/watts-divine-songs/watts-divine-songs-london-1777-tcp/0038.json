{"workId":"watts-divine-songs","editionId":"watts-divine-songs-london-1777-tcp","language":"english","ref":"1.32.2.2","title":"Common Metre.","segments":[{"ref":"1.32.2.2.1","text":"NOW let the FATHER and the SON,"},{"ref":"1.32.2.2.2","text":"And SPIRIT be ador'd,"},{"ref":"1.32.2.2.3","text":"Where there are Works to make Him known,"},{"ref":"1.32.2.2.4","text":"Or Saints to love the LORD."}]}
